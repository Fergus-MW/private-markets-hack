PUBLIC_ORIGIN=http://localhost:5173
PORT=8080
# Web application OAuth client, not the desktop client used by the CLI helper.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_KEY=
# Only verified, explicitly mapped accounts can write connector credentials.
GOOGLE_CONNECTOR_ACCOUNTS={"person@example.com":{"gmail":"projects/PROJECT/secrets/connector-team-mail-oauth","drive":"projects/PROJECT/secrets/connector-team-drive-oauth"}}
