PUBLIC_ORIGIN=http://localhost:5173
PORT=8080
# Web application OAuth client, not the desktop client used by the CLI helper.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_KEY=
# Any verified Google account may connect. Each gets its own derived secret,
# connector-u-<hash>-oauth, created on first connection in this project.
CONNECTOR_PROJECT=
# The connector job's identity, granted read access on each secret created above.
CONNECTOR_SERVICE_ACCOUNT=
