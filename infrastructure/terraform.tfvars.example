project_id = "private-markets-hack-REPLACE"
# org_id = "OPTIONAL_ORGANISATION_ID"
billing_account = "REPLACE_WITH_BILLING_ACCOUNT"
region = "europe-west2"
zone = "europe-west2-a"
invoker_members = ["user:REPLACE@example.com"]
# Set after building and pushing the service image:
# ingestion_image = "europe-west2-docker.pkg.dev/PROJECT/services/ingestion@sha256:..."

# See CONNECTORS.md. Bootstrap with connector_image unset, then authorize accounts.
# google_connectors = {
#   team-mail = { provider = "gmail" } # Empty query reads the full mailbox.
#   team-drive = { provider = "drive" } # All accessible non-trashed files, including Google Docs/Sheets.
# }
# connector_image = "europe-west2-docker.pkg.dev/PROJECT/services/connectors@sha256:..."
# Add schedule = "0 */6 * * *" to an entry to poll every six hours (UTC).

# Multi-user frontend (see services/ingestion/MULTI_USER.md):
# frontend_image = "europe-west2-docker.pkg.dev/PROJECT/services/frontend@sha256:..."
# frontend_public_origin = "https://FRONTEND_SERVICE.run.app"
# frontend_oauth_client_id = "YOUR_WEB_OAUTH_CLIENT_ID.apps.googleusercontent.com"
# Populate frontend-oauth-client-secret and frontend-session-key through Secret Manager.
# After authorizing the repository (see CLOUD_BUILD.md), enable releases:
# github_connection_mode = "github-app" # Or "regional" for a second-generation connection.
# enable_github_trigger = true
# Existing resources managed outside this state must be imported before applying.
# Terraform runs the project namespace migration through gcloud/IAP; it does not build images.

# Email agent (see services/mail_agent/README.md):
# mail_enabled = true
# agentmail_inbox_id = "zeroadmin@agentmail.to"
# mail_image = "europe-west2-docker.pkg.dev/PROJECT/services/agent-mail@sha256:..."
# mail_gemini_model = "gemini-3.1-pro-preview"
# model_gateway_image = "europe-west2-docker.pkg.dev/PROJECT/services/model-gateway@sha256:..."

# Existing runtimes outside this state can receive release-only management:
# frontend_existing_for_cd = true
# existing_connector_release_jobs = {
#   connector-team-drive = "connector-team-drive@PROJECT.iam.gserviceaccount.com"
# }
